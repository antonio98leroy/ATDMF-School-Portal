        blank=True,
    )

    week_start_date = models.DateField()

    week_end_date = models.DateField()

    statement_file = models.FileField(
        upload_to=(
            "finance/bank_statements/%Y/%m/"
        ),
    )

    file_type = models.CharField(
        max_length=20,
        blank=True,
