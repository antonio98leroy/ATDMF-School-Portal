    )

    updated_at = models.DateTimeField(
        auto_now=True,
    )

    class Meta:
        ordering = ["-paid_at"]

        indexes = [
            models.Index(
                fields=["receipt_number"]
            ),
            models.Index(
                fields=["bank_slip_number"]
            ),
            models.Index(
                fields=["paid_at"]
            ),
        ]

    def generate_receipt_number(self):
        year = timezone.localdate().year

        prefix = f"ATDMF-RCT-{year}-"

        last_payment = (
            Payment.objects
            .filter(
                receipt_number__startswith=prefix
            )
            .order_by("-id")
            .first()
        )

        next_number = 1

        if (
            last_payment
            and last_payment.receipt_number
        ):
            try:
                next_number = (
                    int(
                        last_payment
                        .receipt_number
                        .split("-")[-1]
                    )
                    + 1
                )
            except (
                ValueError,
                IndexError,
            ):
                next_number = (
                    last_payment.id + 1
                )

        receipt_number = (
            f"{prefix}{next_number:05d}"
        )

        while Payment.objects.filter(
            receipt_number=receipt_number
        ).exists():
            next_number += 1
            receipt_number = (
                f"{prefix}{next_number:05d}"
            )

        return receipt_number

    def clean(self):
        if self.invoice_id:
            existing_paid = self.invoice.paid_amount

            if self.pk:
                previous = Payment.objects.filter(
                    pk=self.pk
                ).first()

                if previous:
                    existing_paid -= previous.amount

            available_balance = (
                self.invoice.total_amount
                - existing_paid
            )

            if self.amount > available_balance:
                raise ValidationError(
                    {
                        "amount": (
                            "Payment cannot exceed the "
                            f"invoice balance of "
                            f"{available_balance}."
                        )
                    }
                )

    def save(self, *args, **kwargs):
        if not self.receipt_number:
            self.receipt_number = (
                self.generate_receipt_number()
            )

        self.full_clean()
        super().save(*args, **kwargs)

    def __str__(self):
        return (
            f"{self.receipt_number} - "
            f"{self.invoice.student.full_name}"
        )
