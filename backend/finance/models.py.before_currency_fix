                "the selected academic year."
            )

        if (
            self.invoice_id
            and self.invoice.student_id
            != self.student_id
        ):
            errors["invoice"] = (
                "The selected invoice does not belong "
                "to this student."
            )

        if (
            self.invoice_id
            and self.amount > self.invoice.balance
            and not self.payment_id
        ):
            errors["amount"] = (
                "The bank deposit cannot exceed the "
                f"invoice balance of {self.invoice.balance}."
            )

        if errors:
            raise ValidationError(errors)

    def save(self, *args, **kwargs):
        if not self.student_name_on_slip and self.student_id:
            self.student_name_on_slip = (
                self.student.full_name
            )

        self.full_clean()
        super().save(*args, **kwargs)

    def __str__(self):
        return (
            f"{self.bank_slip_number} - "
            f"{self.student_name_on_slip} - "
            f"{self.amount} {self.currency}"
        )
class BankStatement(models.Model):
    class Status(models.TextChoices):
