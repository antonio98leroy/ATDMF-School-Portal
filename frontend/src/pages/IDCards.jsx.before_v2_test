const CARD_WIDTH = "85.60mm";
const CARD_HEIGHT = "53.98mm";


function results(response) {
  return Array.isArray(response?.data)
    ? response.data
    : response?.data?.results || [];
}


function Barcode({ value }) {
  const ref = useRef(null);

  useEffect(() => {
    if (!ref.current || !value) return;

    JsBarcode(ref.current, value, {
      format: "CODE128",
      displayValue: true,
      fontSize: 10,
      height: 34,
      width: 1.45,
      margin: 0,
      background: "transparent",
    });
  }, [value]);

  return <svg ref={ref} />;
}


function CardShell({ children }) {
  return (
    <Box
      sx={{
        width: CARD_WIDTH,
        height: CARD_HEIGHT,
        bgcolor: "white",
        color: "#111827",
        borderRadius: "3mm",
        overflow: "hidden",
        boxShadow:
          "0 12px 36px rgba(15,23,42,0.22)",
        position: "relative",
        border: "0.25mm solid #CBD5E1",
        flexShrink: 0,
        "@media print": {
          boxShadow: "none",
          breakInside: "avoid",
          pageBreakInside: "avoid",
        },
      }}
    >
      {children}
    </Box>
  );
}


