export default function IDCards() {
  const [recordType, setRecordType] =
    useState("STUDENT");
  const [students, setStudents] = useState([]);
  const [employees, setEmployees] = useState([]);
  const [enrollments, setEnrollments] =
    useState([]);
  const [selectedId, setSelectedId] = useState("");
  const [search, setSearch] = useState("");
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    const load = async () => {
      setLoading(true);

      try {
        const [
          studentResponse,
          employeeResponse,
          enrollmentResponse,
        ] = await Promise.all([
          api.get("/students/records/", {
            params: {
              page_size: 2000,
              ordering: "last_name",
            },
          }),
          api.get("/employees/employees/", {
            params: {
              page_size: 1000,
              ordering: "last_name",
            },
          }),
          api.get("/academics/enrollments/", {
            params: {
              page_size: 3000,
              ordering: "-id",
            },
          }),
        ]);

        setStudents(results(studentResponse));
        setEmployees(results(employeeResponse));
        setEnrollments(results(enrollmentResponse));
      } catch {
        setError(
          "Unable to load student and staff records."
        );
      } finally {
        setLoading(false);
      }
    };

    load();
  }, []);

  useEffect(() => {
    setSelectedId("");
    setSearch("");
  }, [recordType]);

  const records =
    recordType === "STUDENT"
      ? students
      : employees;

  const filteredRecords = useMemo(() => {
    const term = search.trim().toLowerCase();

    if (!term) return records;

    return records.filter((item) =>
      [
        item.full_name,
        item.admission_number,
        item.employee_id,
        item.phone,
        item.email,
      ]
        .filter(Boolean)
        .some((value) =>
          String(value)
            .toLowerCase()
            .includes(term)
        )
    );
  }, [records, search]);

  const person = records.find(
    (item) =>
      String(item.id) === String(selectedId)
  );

  const enrollment = useMemo(
    () =>
      enrollments.find(
        (item) =>
          String(
            item.student?.id ||
              item.student
          ) === String(person?.id) &&
          item.active !== false
      ),
    [enrollments, person]
  );

  const identifier =
    recordType === "STUDENT"
      ? person?.admission_number
      : person?.employee_id;

  const subtitle =
    recordType === "STUDENT"
      ? enrollment?.class_name ||
        enrollment?.grade_name ||
        enrollment?.class_section_name ||
        ""
      : [
          person?.position_name,
          person?.department_name,
        ]
          .filter(Boolean)
          .join(" — ");

  if (loading) {
    return (
      <Box
        sx={{
          minHeight: 420,
          display: "grid",
          placeItems: "center",
        }}
      >
        <CircularProgress />
      </Box>
    );
  }

  return (
    <Box>
      <style>
        {`
          @page {
            size: auto;
            margin: 8mm;
          }

          @media print {
            body * {
              visibility: hidden !important;
            }

            #id-card-print-area,
            #id-card-print-area * {
              visibility: visible !important;
            }

            #id-card-print-area {
              position: absolute;
              left: 0;
              top: 0;
              width: 100%;
              display: flex !important;
              flex-wrap: wrap;
              gap: 8mm;
              background: white !important;
              padding: 0 !important;
            }
          }
        `}
      </style>

      <Stack spacing={3}>
        <Box>
          <Typography
            variant="h4"
            fontWeight={900}
            color="#0B2A78"
          >
            ID Card Generator
          </Typography>

          <Typography color="text.secondary">
            Create CR80 computerized student and staff identity cards with Code 128 barcodes.
          </Typography>
        </Box>

        {error && (
          <Alert severity="error">
            {error}
          </Alert>
        )}

        <Paper
          variant="outlined"
          sx={{ p: 3, borderRadius: 3 }}
        >
          <Grid
            container
            spacing={2}
            alignItems="center"
          >
            <Grid size={{ xs: 12, md: 3 }}>
              <FormControl fullWidth>
                <InputLabel>Card Type</InputLabel>

                <Select
                  label="Card Type"
                  value={recordType}
                  onChange={(event) =>
                    setRecordType(
                      event.target.value
                    )
                  }
                >
                  <MenuItem value="STUDENT">
                    Student ID Card
                  </MenuItem>

                  <MenuItem value="EMPLOYEE">
                    Staff ID Card
                  </MenuItem>
                </Select>
              </FormControl>
            </Grid>

            <Grid size={{ xs: 12, md: 4 }}>
              <TextField
                fullWidth
                label="Search Records"
                value={search}
                onChange={(event) =>
                  setSearch(event.target.value)
                }
                slotProps={{
                  input: {
                    startAdornment: (
                      <InputAdornment position="start">
                        <Search />
                      </InputAdornment>
                    ),
                  },
                }}
              />
            </Grid>

            <Grid size={{ xs: 12, md: 4 }}>
              <FormControl fullWidth>
                <InputLabel>Select Person</InputLabel>

                <Select
                  label="Select Person"
                  value={selectedId}
                  onChange={(event) =>
                    setSelectedId(
                      event.target.value
                    )
                  }
                >
                  {filteredRecords.map((item) => (
                    <MenuItem
                      key={item.id}
                      value={item.id}
                    >
                      {item.full_name}
                      {" — "}
                      {item.admission_number ||
                        item.employee_id}
                    </MenuItem>
                  ))}
                </Select>
              </FormControl>
            </Grid>

            <Grid size={{ xs: 12, md: 1 }}>
              <Button
                fullWidth
                variant="contained"
                startIcon={<Print />}
                disabled={!person}
                onClick={() => window.print()}
                sx={{
                  minHeight: 56,
                  bgcolor: "#C8102E",
                }}
              >
                Print
              </Button>
            </Grid>
          </Grid>
        </Paper>

        {!person ? (
          <Paper
            variant="outlined"
            sx={{
              minHeight: 320,
              display: "grid",
              placeItems: "center",
              borderRadius: 3,
            }}
          >
            <Stack
              alignItems="center"
              spacing={1}
            >
              <Badge
                sx={{
                  fontSize: 58,
                  color: "#94A3B8",
                }}
              />

              <Typography color="text.secondary">
                Select a student or employee to generate an ID card.
              </Typography>
            </Stack>
          </Paper>
        ) : (
          <Paper
            variant="outlined"
            sx={{
              p: { xs: 2, md: 4 },
              borderRadius: 3,
              overflowX: "auto",
              bgcolor: "#E2E8F0",
            }}
          >
            <Stack
              id="id-card-print-area"
              direction={{
                xs: "column",
                lg: "row",
              }}
              spacing={3}
              sx={{
                width: "max-content",
                mx: "auto",
              }}
            >
              <FrontCard
                recordType={recordType}
                person={person}
                identifier={identifier}
                subtitle={subtitle}
              />

              <BackCard
                recordType={recordType}
                person={person}
                identifier={identifier}
              />
            </Stack>
          </Paper>
        )}
      </Stack>
    </Box>
  );
}
