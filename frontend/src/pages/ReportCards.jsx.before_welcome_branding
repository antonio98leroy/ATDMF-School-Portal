  return (
    <Stack spacing={3}>
      <Grid container spacing={2}>
        <Grid
          size={{
            xs: 12,
            sm: 6,
            md: 3,
          }}
        >
          <StatCard
            title="Students Ranked"
            value={rows.length}
            icon={<School />}
            color="#0B2A78"
          />
        </Grid>

        <Grid
          size={{
            xs: 12,
            sm: 6,
            md: 3,
          }}
        >
          <StatCard
            title="Top Average"
            value={formatScore(
              topStudent?.overall_average
            )}
            icon={<EmojiEvents />}
            color="#C8102E"
          />
        </Grid>
      </Grid>

      <Paper
        variant="outlined"
        sx={{
          borderRadius: 3,
          overflow: "hidden",
        }}
      >
        <TableContainer>
          <Table>
            <TableHead>
              <TableRow
                sx={{
                  "& th": {
                    bgcolor: "#0B2A78",
                    color: "white",
                    fontWeight: 800,
                  },
                }}
              >
                <TableCell>Position</TableCell>
                <TableCell>
                  Admission Number
                </TableCell>
                <TableCell>Student</TableCell>
                <TableCell>
                  Overall Average
                </TableCell>
                <TableCell>Grade</TableCell>
                <TableCell>Remark</TableCell>
              </TableRow>
            </TableHead>

            <TableBody>
              {rows.map((item) => (
                <TableRow
                  key={item.student_id}
                  hover
                >
                  <TableCell>
                    <Chip
                      label={formatPosition(
                        item.position
                      )}
                      color={
                        item.position === 1
                          ? "warning"
                          : "default"
                      }
                    />
                  </TableCell>

                  <TableCell>
                    {item.admission_number}
                  </TableCell>

                  <TableCell>
                    <Stack
                      direction="row"
                      spacing={1.5}
                      sx={{
                        alignItems: "center",
                      }}
                    >
                      <Avatar
                        sx={{
                          bgcolor:
                            item.position === 1
                              ? "#C8102E"
                              : "#0B2A78",
                        }}
                      >
                        {item.student_name
                          ?.charAt(0)
                          .toUpperCase() || "S"}
                      </Avatar>

                      <Typography fontWeight={700}>
                        {item.student_name}
