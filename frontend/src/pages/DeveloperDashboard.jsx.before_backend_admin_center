import { useEffect, useState } from "react";
import { Alert, Box, Button, Grid, Paper, Typography } from "@mui/material";
import api from "../api/client";
export default function DeveloperDashboard(){const[health,setHealth]=useState(null),[backups,setBackups]=useState([]),[message,setMessage]=useState("");const load=()=>Promise.all([api.get("/system-tools/health/"),api.get("/system-tools/backups/")]).then(([h,b])=>{setHealth(h.data);setBackups(b.data)});useEffect(()=>{load().catch(()=>setMessage("Unable to load system health."))},[]);const backup=()=>api.post("/system-tools/backups/").then(r=>{setMessage(r.data.detail);load()}).catch(e=>setMessage(e.response?.data?.detail||"Backup failed."));return <Box><Typography variant="h4" fontWeight={900} color="#0B2A78">Developer Dashboard</Typography><Typography color="text.secondary" mb={3}>System health, database backup and technical status.</Typography>{message&&<Alert sx={{mb:2}}>{message}</Alert>}<Grid container spacing={3}><Card label="System Status" value={health?.status||"Loading"}/><Card label="Database" value={health?.database?"Connected":"Unavailable"}/><Card label="Free Disk" value={health?`${health.disk_free_gb} GB`:"—"}/><Card label="Django" value={health?.django_version||"—"}/></Grid><Paper sx={{p:3,borderRadius:3,mt:3}}><Button variant="contained" onClick={backup}>Create Database Backup</Button><Typography variant="h6" fontWeight={900} mt={3}>Recent Backups</Typography>{backups.map(x=><Typography key={x.name}>{x.name} — {(x.size/1024).toFixed(1)} KB</Typography>)}</Paper></Box>}
function Card({label,value}){return <Grid size={{xs:12,sm:6,lg:3}}><Paper sx={{p:3,borderRadius:3}}><Typography color="text.secondary">{label}</Typography><Typography variant="h5" fontWeight={900} color="#0B2A78">{value}</Typography></Paper></Grid>}
